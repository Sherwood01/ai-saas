# ==========================================
# AI-SaaS 商业化总控平台环境变量配置模板
# ==========================================

# 1. 应用与基础配置
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=your_auth_secret_key_here

# 2. 底层 AI 算力微服务节点配置 (各独立后端引擎)
# 词汇短视频节点 (vocabulary-video-pipeline, 约定端口 4980)
VOCAB_WORKER_URL=http://localhost:4980
# 知识产权手绘解说视频节点 (ip-video-pipeline, 约定端口 4990)
IP_WORKER_URL=http://localhost:4990
# 故事与探险长视频节点 (预留微服务)
ADVENTURE_WORKER_URL=http://localhost:5200
# 神经语音合成节点 (预留微服务)
VOICEOVER_WORKER_URL=http://localhost:5300

# 3. 第三方 OAuth 登录配置 (可选/按需)
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth (GitHub App)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Microsoft Entra ID OAuth
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# 4. Creem 全球支付与订阅平台
# 测试沙箱使用 creem_test_ 前缀，生产环境使用正式 Key
CREEM_API_KEY=creem_test_your_api_key_here
CREEM_WEBHOOK_SECRET=whsec_your_webhook_secret_here
CREEM_PRODUCT_PRO=prod_pro_id_here
CREEM_PRODUCT_ULTRA=prod_ultra_id_here
CREEM_PRODUCT_STUDIO=prod_studio_id_here
